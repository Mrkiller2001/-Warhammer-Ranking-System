{
  "version": 2,
  "name": "warhammer-ranking-backend",
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/main.py"
    }
  ],
  "env": {
    "FIREBASE_PROJECT_ID": "@firebase_project_id",
    "SECRET_KEY": "@secret_key",
    "CORS_ORIGINS": "@cors_origins"
  }
}
