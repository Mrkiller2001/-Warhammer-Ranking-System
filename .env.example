# =============================================================================
# WARHAMMER RANKING SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file shows all available environment variables.
# Copy the relevant sections to:
#   - backend/.env (for backend configuration)
#   - frontend/.env.development (for frontend local dev)
#
# For production deployment, set these in Vercel Dashboard:
#   Project Settings > Environment Variables
# =============================================================================

# =============================================================================
# BACKEND CONFIGURATION (backend/.env)
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Configuration
# -----------------------------------------------------------------------------
# Get these from: https://console.firebase.google.com/
FIREBASE_PROJECT_ID=your-firebase-project-id

# For LOCAL development: Path to your Firebase service account JSON file
# Download from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# For VERCEL/Production: Base64 encoded credentials (set in Vercel dashboard)
# Generate: cat firebase-credentials.json | base64 -w 0
# FIREBASE_CREDENTIALS=<base64-encoded-json>

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_TITLE=Warhammer Ranking System API
API_VERSION=2.0.0

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-CHANGE-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# Local development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production (add your Vercel domain):
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# -----------------------------------------------------------------------------
# Discord Bot (Optional)
# -----------------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Options: development, production
ENVIRONMENT=development

# =============================================================================
# FRONTEND CONFIGURATION (frontend/.env.development)
# =============================================================================

# -----------------------------------------------------------------------------
# API URL
# -----------------------------------------------------------------------------
# For LOCAL development:
VITE_API_URL=http://localhost:8000/api

# For PRODUCTION (set in Vercel dashboard):
# VITE_API_URL=https://your-backend.vercel.app/api
# or if using Railway/Render:
# VITE_API_URL=https://your-backend.railway.app/api

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# LOCAL DEVELOPMENT:
# 1. Copy backend/.env.example to backend/.env
# 2. Download Firebase credentials and save as firebase-credentials.json
# 3. Update FIREBASE_PROJECT_ID with your project ID
# 4. Frontend will use .env.development automatically
#
# VERCEL DEPLOYMENT (Frontend):
# 1. Set in Vercel Dashboard > Environment Variables:
#    - VITE_API_URL = https://your-backend.vercel.app/api
#
# VERCEL DEPLOYMENT (Backend - if using Vercel for backend):
# 1. Set in Vercel Dashboard > Environment Variables:
#    - FIREBASE_PROJECT_ID = your-project-id
#    - FIREBASE_CREDENTIALS = (base64 encoded JSON)
#    - SECRET_KEY = (generate secure key)
#    - CORS_ORIGINS = https://your-frontend.vercel.app
#
# RAILWAY/RENDER DEPLOYMENT (Backend - recommended):
# 1. Set environment variables in dashboard:
#    - FIREBASE_PROJECT_ID
#    - SECRET_KEY
#    - CORS_ORIGINS
#    - Upload firebase-credentials.json file
#    - Set FIREBASE_CREDENTIALS_PATH=/path/to/uploaded/file
#
# =============================================================================
