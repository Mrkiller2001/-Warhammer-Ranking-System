# Production Environment Variables (for Render)
# These will be set automatically by Render through render.yaml

# Database - Set by Render from PostgreSQL database
DATABASE_URL=postgresql://user:password@host:5432/warhammer_rankings

# API Configuration
API_HOST=0.0.0.0
PORT=10000
API_RELOAD=False
ENVIRONMENT=production

# Security - Use Render's generated secret key
SECRET_KEY=your-generated-secret-key-from-render
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Allow all origins in production (can be restricted later)
CORS_ORIGINS=*

# Discord Bot (Optional - set in Render Dashboard if needed)
DISCORD_TOKEN=
DISCORD_GUILD_ID=
